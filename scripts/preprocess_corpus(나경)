
import json
import re
from pathlib import Path

import fitz  # PyMuPDF


# =====================================
# 1. 파일 경로
# =====================================

ROOT_DIR = Path(__file__).resolve().parent.parent

PDF_PATH = ROOT_DIR / "data" / "corpus(나경).pdf"
OUTPUT_PATH = ROOT_DIR / "data" / "corpus_nakyung.jsonl"

# 문자 수 기준 청킹 설정
CHUNK_SIZE = 1000
CHUNK_OVERLAP = 150
MIN_CHUNK_SIZE = 50


# =====================================
# 2. PDF 텍스트 전처리
# =====================================

def clean_text(text: str) -> str:
    """불필요한 공백과 제어문자를 정리한다."""

    if not text:
        return ""

    # 줄바꿈으로 분리된 영문 단어 연결
    text = re.sub(r"(?<=\w)-\s*\n\s*(?=\w)", "", text)

    # 줄바꿈 통일
    text = text.replace("\r\n", "\n").replace("\r", "\n")

    # 제어문자 제거
    text = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", text)

    # 연속 공백 정리
    text = re.sub(r"[^\S\n]+", " ", text)

    # 빈 줄 정리
    text = re.sub(r"\n[ \t]*\n+", "\n\n", text)

    return text.strip()


# =====================================
# 3. 텍스트 청킹
# =====================================

def split_text(text: str) -> list[str]:
    """문단과 문장 경계를 우선 고려하여 청킹한다."""

    chunks = []
    start = 0

    while start < len(text):
        end = min(start + CHUNK_SIZE, len(text))

        if end < len(text):
            # 청크 끝부분의 문단/문장 경계 탐색
            search_start = start + int(CHUNK_SIZE * 0.7)

            boundaries = [
                text.rfind("\n\n", search_start, end),
                text.rfind("\n", search_start, end),
                text.rfind(". ", search_start, end),
                text.rfind("? ", search_start, end),
                text.rfind("! ", search_start, end),
                text.rfind("다. ", search_start, end),
                text.rfind("요. ", search_start, end),
            ]

            boundary = max(boundaries)

            if boundary >= search_start:
                end = boundary + 1

        chunk = text[start:end].strip()

        if len(chunk) >= MIN_CHUNK_SIZE:
            chunks.append(chunk)

        if end >= len(text):
            break

        # 다음 청크에 이전 청크의 일부 문맥을 포함
        start = max(start + 1, end - CHUNK_OVERLAP)

        # 공백에서 시작하는 불필요한 부분 제거
        while start < len(text) and text[start].isspace():
            start += 1

    return chunks


# =====================================
# 4. PDF 추출 및 JSONL 저장
# =====================================

def main():
    if not PDF_PATH.exists():
        print(f"[오류] PDF 파일을 찾을 수 없습니다:\n{PDF_PATH}")
        print("파일명과 확장자(.pdf)가 정확한지 확인하세요.")
        return

    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)

    total_chunks = 0
    empty_pages = 0

    with fitz.open(PDF_PATH) as pdf, \
            OUTPUT_PATH.open("w", encoding="utf-8") as output:

        for page_number, page in enumerate(pdf, start=1):
            raw_text = page.get_text("text", sort=True)
            text = clean_text(raw_text)

            if not text:
                empty_pages += 1
                continue

            chunks = split_text(text)

            for chunk_number, chunk in enumerate(chunks, start=1):
                record = {
                    "id": (
                        f"nakyung_p{page_number}"
                        f"_c{chunk_number}"
                    ),
                    "text": chunk,
                    "metadata": {
                        "source": PDF_PATH.name,
                        "page": page_number,
                        "chunk_index": chunk_number,
                        "char_count": len(chunk)
                    }
                }

                output.write(
                    json.dumps(record, ensure_ascii=False) + "\n"
                )

                total_chunks += 1

    print("\n===== 처리 완료 =====")
    print(f"PDF 파일: {PDF_PATH.name}")
    print(f"총 페이지: {len(pdf)}")
    print(f"빈 페이지: {empty_pages}")
    print(f"생성된 청크: {total_chunks}")
    print(f"저장 위치: {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
